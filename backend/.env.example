# ==============================================================================
# India Legal News Aggregator - Environment Configuration Blueprint
# Free-Tier MVP Architecture ($0/month) | Target RAM: < 250 MB
# ==============================================================================

# Application Environment & Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO
PROJECT_NAME="India Legal News Aggregator"

# PostgreSQL + pgvector Database Connection
# Neon / Supabase Free Tier or Local PostgreSQL with pgvector extension enabled
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/india_legal_aggregator

# Redis Connection (Upstash Redis Free Tier or Local Redis)
# Format: redis://[[username]:[password]]@[host]:[port]/[db]
REDIS_URL=redis://localhost:6379/0

# JWT & Application Security
# Minimum 32-character secret string for signing HS256 tokens
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth Client ID (For user SSO & cloud bookmarks sync)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Admin Authentication (For manual RSS trigger POST /api/v1/admin/refresh)
ADMIN_API_KEY=dev-admin-secret-key-change-in-production

# Embedding Model Provider (< 250 MB Total RAM Budget)
# Supported options: 'onnx' (lightweight ~85MB onnxruntime), 'hf' (HuggingFace Inference API), 'deterministic' (fallback)
EMBEDDING_PROVIDER=onnx

# Hugging Face API Token (Optional, used if EMBEDDING_PROVIDER=hf)
HF_API_TOKEN=hf_your_huggingface_api_token_here

# Cross-Origin Resource Sharing (CORS) - JSON Array format or comma-separated URLs
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
